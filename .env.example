# Copie para .env e preencha localmente. Nunca versione o .env.
# Data lake da turma (RustFS compatível com S3, ADR-008). As variáveis MINIO_*
# apontam para qualquer servidor S3. A chave da turma vem do canal da turma e
# fica só no .env e nos secrets do GitHub; nunca neste arquivo.
# Desenvolvimento no MinIO local: MINIO_ENDPOINT=localhost:9000 e MINIO_SECURE=false.
MINIO_ENDPOINT=s3.afonsolelis.tech
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=tcg
MINIO_SECURE=true
GROUP_ID=24269
TCG_USER_AGENT=colecao-dri/1.0
